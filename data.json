    "adult": {
      "label_zh": "成人全年龄活动",
      "subtitle_zh": "任何年龄成人均可参加，不需要 55+ 会员",
      "updated": "2026-09-01",
      "period_label": "2026年秋季课表（9月7日 – 2027年1月3日）",
      "membership_note": "现场付费即可参加：$8.20/次（14-17岁 或 65岁以上），$11.75/次（18-64岁）。常来的话购买健身会员更划算，详见官网 Memberships 页。",
      "closures": [
        "9月7日（劳动节）、10月12日（感恩节）：暂停",
        "12月24日16:00后、12月25/26/31日16:00后、1月1日：暂停"
      ],
      "facility_fees": {
        "title_zh": "健身房 Fitness Studio / 室内跑道 单次收费",
        "note_zh": "现场付费，按次收费；常去的话官网也有健身会员，价格需另外查询",
        "rows": [
          {
            "age": "14-17 岁",
            "studio": "$8.20",
            "track": "$3.30"
          },
          {
            "age": "18-64 岁",
            "studio": "$11.75",
            "track": "$4.65"
          },
          {
            "age": "65 岁以上",
            "studio": "$8.20",
            "track": "$3.25"
          }
        ]
      },
      "class_descriptions": {
        "Body Blast": "全身综合训练课，用不同器材和动作组合，全面锻炼身体各部位肌肉，中高强度。",
        "Boot Camp": "高强度燃脂训练，结合肌力和心肺训练，适合想挑战体能、快速见效的人，强度较大。",
        "CycleFit": "室内动感单车课，模拟平路骑行、爬坡和冲刺，全程心肺训练，适合喜欢有氧运动的人。",
        "Dancercise": "跟着音乐做有氧舞蹈，不需要任何舞蹈基础，边跳边燃脂塑形，气氛比较轻松。",
        "Interval Insanity": "高强度间歇训练，心肺、核心、负重动作交替进行，追求快速见效，强度较大。",
        "Sculpt & Tone": "借助器械做阻力训练，专注雕塑和收紧全身线条，强度适中。",
        "Piloga": "普拉提与瑜伽结合的课程，动作连贯柔和，锻炼力量和柔软度，同时帮助放松，强度较温和。",
        "Abs, Butt & Thighs": "专门针对腹部、臀部和大腿的塑形训练，强化核心肌群，适合各年龄和体能水平。"
      },
